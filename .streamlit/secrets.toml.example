# Paste into Streamlit Community Cloud > your app > Settings > Secrets
# (or .streamlit/secrets.toml for local runs). Never commit the real file.
# Keep the simple "name = value" lines at the TOP, before any [section].

sheet_id = "1cxOtb4Q4CQsgkYzdnCgetsQsibKFlpmzsKeV6yUoTuA"

# The owner can always sign in and manage access.
owner_email = "owner@yourcompany.com"
# Used only for the owner's very first sign-in, then the owner sets their own PIN.
owner_initial_pin = "482915"
# Long random string mixed into every PIN hash. Set once; changing it invalidates all PINs.
pin_pepper = "replace-with-a-long-random-string"

# How often the master tabs are re-read, in seconds.
master_cache_seconds = 60

# Service account key: open the downloaded .json key file in Notepad, copy
# EVERYTHING (from the first { to the last }), and paste it between the
# triple quotes below, replacing the example. Do not change anything in it.
gcp_service_account_json = '''
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''

# Optional:
# edit_cutoff_days = 1      # indents editable until the next day...
# edit_cutoff_hour = 12     # ...at 12:00 PM IST
# show_spec = false         # origin / size switched off
